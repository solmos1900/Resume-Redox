# Client Firebase (optional sign-in + cloud sync; also issues anonymous guest
# tokens for server PDF — enable Anonymous sign-in in the Firebase console).
# Without these the app still works fully; PDF falls back to the print view.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side PDF export auth (issue #41)
# Verifies Firebase ID tokens via Google JWKS — no service-account JSON needed.
# Prefer FIREBASE_PROJECT_ID; falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# If unset in production, POST /api/export-pdf fails closed (503).
FIREBASE_PROJECT_ID=

# Optional PDF export abuse / resource tunables (sensible defaults apply)
# PDF_EXPORT_MAX_CONCURRENCY=2
# PDF_EXPORT_TIMEOUT_MS=45000

# Optional Chromium overrides (existing)
# CHROMIUM_REMOTE_EXEC_PATH=
# CHROMIUM_PATH=
# PUPPETEER_EXECUTABLE_PATH=
# FORCE_SERVERLESS_CHROMIUM=1
